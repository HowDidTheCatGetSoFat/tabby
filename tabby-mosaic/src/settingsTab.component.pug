h3.mb-3(translate) Mosaic

.form-line
    .header
        .title(translate) Default layout
        .description(translate) Layout used when tiling tabs and windows
    select.form-control.w-auto(
        [(ngModel)]='config.store.mosaic.preset',
        (ngModelChange)='config.save()'
    )
        option(value='grid', translate) Grid
        option(value='columns', translate) Columns
        option(value='rows', translate) Rows
        option(value='master', translate) Master stack

.form-line
    .header
        .title(translate) Re-tile on tab open/close
        .description(translate) Automatically re-tile the active window when a tab is opened or closed
    toggle(
        [(ngModel)]='config.store.mosaic.rearrangeOnChange',
        (ngModelChange)='config.save()'
    )

.form-line
    .header
        .title(translate) Tile windows after moving a tab out
        .description(translate) When a tab is moved to a new window, tile all windows
    toggle(
        [(ngModel)]='config.store.mosaic.tileWindowsOnMove',
        (ngModelChange)='config.save()'
    )

.form-line
    .header
        .title(translate) Tile windows across all monitors
        .description(translate) Spread windows over every display instead of just the active one
    toggle(
        [(ngModel)]='config.store.mosaic.tileAcrossMonitors',
        (ngModelChange)='config.save()'
    )

.form-line
    .header
        .title(translate) Tile title bars
        .description(translate) Show a title bar with actions on each tile
    select.form-control.w-auto(
        [(ngModel)]='config.store.mosaic.paneBar',
        (ngModelChange)='config.save()'
    )
        option(value='hover', translate) On hover
        option(value='always', translate) Always
        option(value='off', translate) Off

.form-line
    .header
        .title(translate) Title bar animation
        .description(translate) Fade duration of the tile title bar, in milliseconds
    input.form-control.w-auto(
        type='number',
        min='0',
        [(ngModel)]='config.store.mosaic.paneBarAnimationMs',
        (ngModelChange)='config.save()'
    )
